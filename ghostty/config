# Ghostty — reload with Cmd+Shift+, (no restart needed)
# Browse themes: ghostty +list-themes   ·   All options: ghostty +show-config --default --docs

# Look
theme = light:Rose Pine Dawn,dark:Rose Pine
font-size = 14
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-save-state = always

# Behavior
macos-option-as-alt = true
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = true
shell-integration-features = cursor,sudo,title

# Drop-down terminal from any app: Ctrl+`
# (macOS asks for Accessibility permission the first time)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
